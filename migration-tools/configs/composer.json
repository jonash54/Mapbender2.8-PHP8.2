{
    "name": "mapbender/migration-tools",
    "description": "Dev-only tooling for the PHP 8.2 migration of Mapbender 2.8. Not part of the runtime.",
    "type": "project",
    "license": "MIT",
    "config": {
        "vendor-dir": "/opt/mig-tools/vendor",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "rector/rector": "^1.2",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "scripts": {
        "post-install-cmd": [
            "phpcs --config-set installed_paths /opt/mig-tools/vendor/phpcompatibility/php-compatibility"
        ]
    }
}
